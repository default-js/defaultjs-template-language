{
	"name": "@default-js/defaultjs-template-language",
	"buildname": "defaultjs-template-language",
	"version": "2.0.0",
	"description": "template language to compute html content with javascript and/or remote json data. If, foreach, include, choose and many more function, usable as declarative syntax!",
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./index.js": "./index.js",
		"./browser.js": "./browser.js",
		"./src/*": "./src/*",
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "webpack --mode=development --progress",
		"build:prod": "webpack --mode=production --progress",
		"build": "npm run test && npm run build:dev && npm run build:prod",
		"dev": "webpack serve --mode=development --progress",
		"test:live": "vitest --browser.headless=false",
		"test": "vitest run",
		"bench": "vitest bench --run --no-file-parallelism --project chromium && vitest bench --run --no-file-parallelism --project firefox && vitest bench --run --no-file-parallelism --project webkit"
	},
	"keywords": [],
	"author": "Frank Schüler",
	"license": "MIT",
	"devDependencies": {
		"@vitest/browser": "^5.0.3",
		"@vitest/browser-playwright": "^5.0.3",
		"clean-webpack-plugin": "^1.0.1",
		"http-server": "^14.1.0",
		"playwright": "^1.64.0",
		"replace-in-file-webpack-plugin": "^1.0.6",
		"terser-webpack-plugin": "^5.3.1",
		"vitest": "^5.0.3",
		"webpack": "^5.74.0",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.1.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/default-js/defaultjs-template-language.git"
	},
	"bugs": {
		"url": "https://github.com/default-js/defaultjs-template-language/issues"
	},
	"homepage": "https://github.com/default-js/defaultjs-template-language#readme",
	"dependencies": {
		"@default-js/defaultjs-common-utils": "^1.0.0",
		"@default-js/defaultjs-expression-language": "^3.0.2",
		"@default-js/defaultjs-extdom": "^2.0.0"
	},
	"files": [
		"index.js",
		"browser.js",
		"src/**",
		"dist/**",
		"LICENSE",
		"README.md",
		"package.json"
	]
}
